                                 <fo:block>
                                    <fo:block>link or URL to the original Eclipse Foundation document.</fo:block>
                                 </fo:block>
                              </fo:list-item-body>
                           </fo:list-item>
                           <fo:list-item space-before.optimum="2pt"
                                         space-before.minimum="2pt"
                                         space-before.maximum="2pt"
                                         id="d194e23">
                              <fo:list-item-label end-indent="label-end()">
                                 <fo:block>•</fo:block>
                              </fo:list-item-label>
                              <fo:list-item-body start-indent="body-start()">
                                 <fo:block>
                                    <fo:block>All existing copyright notices, or if one does not exist, a
        notice (hypertext is preferred, but a textual representation is
        permitted) of the form: "Copyright © [$date-of-document] Eclipse
        Foundation, Inc. &lt;&lt;url to this license&gt;&gt;"</fo:block>
