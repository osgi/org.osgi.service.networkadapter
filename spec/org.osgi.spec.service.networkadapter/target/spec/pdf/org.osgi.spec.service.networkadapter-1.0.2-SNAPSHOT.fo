               <fo:block id="org.osgi.service.networkadapter.NetworkAddress.getInetAddress--">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
